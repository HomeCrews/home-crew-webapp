/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    /*
      strict was NOT in the generated file. It is the umbrella that turns on
      strictNullChecks, noImplicitAny, strictFunctionTypes and the rest, and
      without it the individual flags below cover only a fraction of what they
      look like they cover. Added here before there is any code to migrate -
      retrofitting it onto a real app is a large, unrewarding diff.
    */
    "strict": true,

    /* Dead code is a review cost and a source of confusion. Cheap to keep out
       from the start; the linter's no-unused-vars catches the same thing in
       editors that do not run tsc. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* obj[key] is T | undefined rather than T. Verbose, and the single most
       effective guard against a runtime "cannot read property of undefined"
       once this app starts handling API responses. */
    "noUncheckedIndexedAccess": true,

    /* macOS and Windows have case-insensitive filesystems, Linux CI does not.
       Without this, an import that differs only in case works locally and
       fails in the Docker build. */
    "forceConsistentCasingInFileNames": true,

    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,

    /*
      strictTemplates was also missing, and it is the Angular half of "strict".
      Without it a template can pass a string to a number @Input, or call a
      method that does not exist, and the build says nothing - the error only
      appears at runtime as an empty or broken component.
    */
    "strictTemplates": true,

    /* Same checking for host bindings, which strictTemplates alone does not
       cover. */
    "typeCheckHostBindings": true,

    /* Every component in this app is standalone; this makes an accidental
       NgModule-based one a compile error rather than a surprise later. */
    "strictStandalone": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
