# Prettier's job here is the application source. Everything below is either
# generated, shared with the other fourteen repositories, or hand-formatted,
# and reformatting it buys nothing while creating diff noise.

# Build output and dependencies
/dist
/node_modules
/.angular

# Generated by `ng new` and by the Angular CLI. Notably these do NOT satisfy
# the .prettierrc that the CLI generates alongside them, because .prettierrc
# sets singleQuote and the generators emit double quotes.
angular.json
package.json
package-lock.json
tsconfig.json
tsconfig.app.json
tsconfig.spec.json
.prettierrc
.vscode/

# Markdown is wrapped by hand across this project - prettier pads every table
# cell and the result is a large diff that reads no better.
*.md

# Community health files come from _standards/templates/github/, shared with
# every other repository. Formatting them only here would make them diverge.
.github/
