# Pin the PUBLIC registry, explicitly.
#
# This is not a default worth leaving implicit: a machine can have
# NPM_CONFIG_REGISTRY pointing at a private mirror in its shell environment,
# and npm's env config outranks any file. Without this line, `npm install` on
# such a machine resolves through that mirror and writes its hostname into
# every `resolved` URL in package-lock.json - committing an internal hostname
# to a public repository and producing a lockfile nobody else can install from.
#
# A project-local .npmrc does NOT override an environment variable. To generate
# the lockfile on a machine like that, pass the registry on the command line:
#
#     npm install --registry=https://registry.npmjs.org/
#
# and check the result before committing:
#
#     grep -c 'registry.npmjs.org' package-lock.json
#     grep -vc 'registry.npmjs.org' package-lock.json   # expect no other hosts
registry=https://registry.npmjs.org/
